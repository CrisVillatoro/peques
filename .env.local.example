# Supabase project for Peques (Settings → API in the Supabase dashboard).
# Copy this file to .env.local and fill both values.
#
# These two are safe in the browser: the anon key only grants what Row Level
# Security allows, and every row is tied to its own account.
#
# Without them the app still works — saving then stays in the browser only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
